    </Reference>
    <!-- Game assembly: needed for EngineInterface.GameAction(Enums.GameActionCommand,...) — the
         recruit (MakeTroop) command intercepted by MakeTroopRecruitHook for unit MaxCount. -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameDir)\Stronghold Crusader Definitive Edition_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- MonoMod RuntimeDetour (shipped in BepInEx core) for the MakeTroop GameAction detour. -->
    <Reference Include="MonoMod.RuntimeDetour">
