  </PropertyGroup>
  <!-- ============================================================================================
       BUILD OUTPUT vs DEPLOY
       ============================================================================================

       The build writes to the repo only: bin\$(Configuration)\ (both Debug and Release). It never
       writes into the game folder. Installing is a separate, explicit step:

         .\scripts\deploy.ps1            copies bin\Release\ into <GameDir>\BepInEx\plugins\CrusaderDETweaker\
         .\scripts\build.ps1 -Deploy     build, then deploy.ps1

       deploy.ps1 refuses while the game is running, backs up the replaced plugin files, and never
       touches BepInEx\config. Override the output folder with /p:OutputPath=... (the ship pipeline
       builds into dist\).

       Identity (unchanged):
       - Plugin GUID: "CrusaderDETweaker" (PluginInfo.cs); BepInEx folder: BepInEx/plugins/CrusaderDETweaker/
       - User configs: BepInEx/config/CrusaderDETweaker/ (GlobalMultipliers .cfg, TOML files, DamageMatrices\*.csv)
       - Do not use "ensrick.crusaderdetweaker" (an old, incorrect GUID).
       ============================================================================================ -->
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
