  <!-- ============================================================================================
       CRITICAL BUILD PATH CONFIGURATION
       ============================================================================================
       
       BepInEx loads plugins from folders matching their plugin GUID. The plugin GUID is defined
       in Plugin.cs as [BepInPlugin("CrusaderDETweaker", ...)].
       
       REQUIREMENTS:
       - Plugin GUID: "CrusaderDETweaker" (defined in Plugin.cs)
       - Plugin folder: BepInEx/plugins/CrusaderDETweaker/
       - DLL location: BepInEx/plugins/CrusaderDETweaker/CrusaderDETweaker.dll
       - Config file: BepInEx/config/CrusaderDETweaker.cfg
       
       BOTH Debug AND Release builds MUST output to the SAME folder:
       GamePath\BepInEx\plugins\CrusaderDETweaker\
       
       DO NOT:
       - Use different folders for Debug vs Release
       - Change the GUID without updating ALL build paths
       - Use "ensrick.crusaderdetweaker" (this was an old incorrect GUID)
       
       If you see a DLL in plugins/ensrick.crusaderdetweaker/, it's from an old build and should
       be deleted. Only plugins/CrusaderDETweaker/ is the correct location.
       ============================================================================================ -->
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <!-- Debug OutputPath: MUST match plugin GUID "CrusaderDETweaker" -->
    <OutputPath>$(GameDir)\BepInEx\plugins\CrusaderDETweaker\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <!-- Release OutputPath: MUST match plugin GUID "CrusaderDETweaker" (same as Debug) -->
    <!-- CRITICAL: Both Debug and Release use the SAME folder. This is intentional. -->
    <OutputPath>$(GameDir)\BepInEx\plugins\CrusaderDETweaker\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
