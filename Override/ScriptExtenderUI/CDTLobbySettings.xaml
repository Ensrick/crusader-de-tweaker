<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Crusader DE Tweaker: lobby tab in SHCDE-SE's Mod Options hub (SE 2.8.0 lobby mod settings).
        DataContext: CrusaderDETweaker.Config.Sync.ConfigSyncLobbySettings. Design: docs/HOST_SYNC_DESIGN.md.
        Layout follows SE's ModSettingsTemplate.xaml (Grid > ScrollViewer > StackPanel).
        - SyncEnabled is [SyncHostOnly]: IsEnabled="{Binding IsHost}" only greys it out for clients;
          the setter's CanEdit() gate is what enforces it.
        - Tooltips use DynamicResource: lobby views load before the game's global XAML dictionaries.
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">

            <TextBlock Text="MULTIPLAYER: HOST CONFIG SYNC"
                       Foreground="#77AAFF"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

            <CheckBox IsChecked="{Binding SyncEnabled}"
                      Content="Players who join use my configs (host only)"
                      Foreground="White"
                      Margin="0,5"
                      IsEnabled="{Binding IsHost}">
                <CheckBox.ToolTip>
                    <ToolTip Style="{DynamicResource SE_ToolTip_Scale}"
                             Content="Sends your unit, structure, gameplay, damage-matrix and multiplier configs to every player in this lobby for its matches. Their own files are never changed and apply again when they leave."/>
                </CheckBox.ToolTip>
            </CheckBox>

            <TextBlock Text="When on, everyone in this lobby plays with the host's Crusader DE Tweaker configs, so nobody has to copy config files before a match. Only the host can change this."
                       Foreground="#AAAAAA"
                       TextWrapping="Wrap"
                       Margin="0,5,0,10"/>

            <TextBlock Text="STATUS"
                       Foreground="#77AAFF"
                       FontWeight="Bold"
                       Margin="0,5,0,5"/>

            <TextBlock Text="{Binding Status}"
                       Foreground="#CCCC77"
                       TextWrapping="Wrap"
                       Margin="0,2"/>

            <TextBlock Text="{Binding Details}"
                       Foreground="#AAAAAA"
                       TextWrapping="Wrap"
                       Margin="0,2"/>

            <!-- GitLab #5: lobby MaxCount values (ConfigSyncLobbySettings.MaxCounts, Config/Sync/LobbyMaxCounts.cs).
                 Rows are UI only; an edit rebuilds the one [SyncHostOnly] string. IsEnabled greys the boxes out
                 for clients; the ViewModel's CanEdit() gate is what enforces it. -->
            <TextBlock Text="UNIT AND BUILDING LIMITS (MaxCount)"
                       Foreground="#77AAFF"
                       FontWeight="Bold"
                       Margin="0,15,0,5"/>

            <TextBlock Text="Empty = use the Units / Structures file. -1 = no limit, 0 = not allowed, a number = at most that many at once (units alive, buildings placed). Set by the host for every player in this lobby; in single player they are yours. Kept for your next game."
                       Foreground="#AAAAAA"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"/>

            <TextBlock Text="Units"
                       Foreground="White"
                       FontWeight="Bold"
                       Margin="0,0,0,4"/>

            <ItemsControl x:Name="CDT_UnitMaxCounts"
                          ItemsSource="{Binding UnitMaxCounts}"
                          IsEnabled="{Binding IsHost}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Width="270" Margin="0,2">
                            <TextBlock Text="{Binding Label}" Width="190" Foreground="White" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="60"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Buildings"
                       Foreground="White"
                       FontWeight="Bold"
                       Margin="0,10,0,4"/>

            <ItemsControl x:Name="CDT_BuildingMaxCounts"
                          ItemsSource="{Binding BuildingMaxCounts}"
                          IsEnabled="{Binding IsHost}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Width="270" Margin="0,2">
                            <TextBlock Text="{Binding Label}" Width="190" Foreground="White" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="60"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</Grid>
